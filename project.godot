; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Space Horror Game"
run/main_scene="res://scenes/Map/MapScene.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[autoload]

GameManager="*res://src/GameManager.gd"
MapGenerator="*res://src/MapGenerator.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[gui]

theme/custom="res://themes/CultTheme.tres"

[rendering]

environment/defaults/default_clear_color=Color(0.0313726, 0.0313726, 0.0470588, 1)
